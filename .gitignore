# Custom TradingAgents extension - keep API keys and portfolio data out of git
# These are already in upstream .gitignore for the tradingagents/ dir,
# but the custom package has its own concerns.

# API keys (should live in ~/.zshrc or a local .env, NEVER in git)
**/secrets.py
**/config.local.py
*.env
.env

# Personal portfolio and analysis cache
~/.tradingagents/
portfolio.json
*.portfolio.json

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Test artifacts
.pytest_cache/
*.log
